import numpy as np
import casadi as cs

from acados_template import AcadosOcp, AcadosModel

# ============================================================
#   OCP FORMULATION FOR THE PERCHING GLIDER (L2 AND L1)
#   Fully compatible with model_perching.py and Module 3
# ============================================================

def build_ocp_common(model: AcadosModel,
                     x0: np.ndarray,
                     N: int = 100,
                     dt: float = 0.02,
                     Q: np.ndarray = None,
                     R: float = 0.1,
                     S_time: float = 1e-4):
    """
    Base OCP structure used by both L2 and L1 terminal versions.
    Terminal cost is added afterward depending on L2/L1 choice.
    """

    # Build symbolic expression
    x = model.x
    u = model.u

    nx = x.size()[0]
    nx_phys = nx - 1   # exclude dt_var
    nu = u.size()[0]

    ocp = AcadosOcp()
    ocp.model = model
    ocp.model.f_expl_expr = model.f_expl_expr
    ocp.model.f_impl_expr = model.f_impl_expr
    ocp.solver_options.N_horizon = N
    ocp.solver_options.tf = N   #because now dynamics are scaled by dt

    # -------------------------
    # COST: Stage cost (always L2)
    # -------------------------

    ocp.cost.cost_type = "NONLINEAR_LS"

    if Q is None:
        Q = np.diag([5., 5., 0., 0., 1., 1., 0.])

    # symbols
    x = model.x
    u = model.u
    dt_var = x[nx-1]
    x_phys = x[:nx_phys]

    # --- build Q_sqrt (assumes Q is diagonal) ---
    Q_diag = np.diag(Q)
    Q_sqrt = cs.diag(cs.sqrt(cs.DM(Q_diag)))   # (nx_phys x nx_phys)

    # --- sqrt(dt) ---
    # add tiny epsilon to avoid NaNs in derivative near 0
    sqrt_dt = cs.sqrt(dt_var + 1e-12)

    # residual blocks
    r_x = sqrt_dt * (Q_sqrt @ x_phys)                  # nx_phys
    r_u = sqrt_dt * (cs.sqrt(R) * u)                   # nu
    r_t = cs.sqrt(S_time) * dt_var                     # 1   -> gives S_time * dt^2

    y_expr = cs.vertcat(r_x, r_u, r_t)

    ocp.model.cost_y_expr = y_expr

    ny = nx_phys + nu + 1
    ocp.cost.W = np.eye(ny)
    ocp.cost.yref = np.zeros(ny)

    # -------------------------
    # CONSTRAINTS
    # -------------------------
    # Initial condition
    ocp.constraints.idxbx_0 = np.arange(nx_phys)
    ocp.constraints.lbx_0   = x0[:nx_phys].copy()
    ocp.constraints.ubx_0   = x0[:nx_phys].copy()

    # Control bounds: u in [-13, 13]
    ocp.constraints.lbu = np.array([-13.0])
    ocp.constraints.ubu = np.array([13.0])
    ocp.constraints.idxbu = np.array([0])

    # State bounds: phi ∈ [-π/3, π/8] and dt ∈ [1e-4, 0.2]
    idx_phi = 3
    idx_dt  = 7

    dt_min = 1e-4
    dt_max = 0.2

    ocp.constraints.idxbx = np.array([idx_phi, idx_dt])
    ocp.constraints.lbx   = np.array([-np.pi/3, dt_min])
    ocp.constraints.ubx   = np.array([ np.pi/8, dt_max])

    # -------------------------
    # OCP solver options
    # -------------------------
    ocp.solver_options.qp_solver = "FULL_CONDENSING_HPIPM"
    ocp.solver_options.hessian_approx = "GAUSS_NEWTON"
    ocp.solver_options.integrator_type = "ERK"
    ocp.solver_options.sim_method_num_stages = 4
    ocp.solver_options.sim_method_num_steps = 4

    ocp.solver_options.nlp_solver_type = "SQP"
    ocp.solver_options.nlp_solver_max_iter = 50
    ocp.solver_options.print_level = 0

    ocp.solver_options.globalization = "MERIT_BACKTRACKING"
    ocp.solver_options.globalization_use_SOC = 1
    ocp.solver_options.qp_solver_iter_max = 50


    ocp.cost.zl = np.array([])  # no slacks here
    ocp.cost.zu = np.array([])
    ocp.cost.Zl = np.array([])
    ocp.cost.Zu = np.array([])
    ocp.cost.Z = np.array([])
    ocp.cost.z = np.array([])

    return ocp


# ======================================================================
# L2 TERMINAL COST OCP
# ======================================================================

def build_ocp_l2(model: AcadosModel,
                 x0: np.ndarray,
                 N: int = 100,
                 dt: float = 0.02,
                 Q: np.ndarray = None,
                 Q_N: np.ndarray = None,
                 R: float = 0.1,
                 S_time: float = 1e-4):
    """
    Build an OCP with L2 terminal cost:
        Φ = (x_N - x_target)^T Q_N (x_N - x_target)
    """

    ocp = build_ocp_common(model, x0, N, dt, Q, R, S_time)
    nx = model.x.size()[0]
    nx_phys = nx - 1   # exclude dt_var

    if Q_N is None:
        Q_N = np.diag([400, 400, 1/9, 1/9, 1, 1, 1/9])

    ocp.cost.cost_type_e = "LINEAR_LS"
    ocp.cost.Vx_e = np.zeros((nx_phys, nx))
    ocp.cost.Vx_e[:, :nx_phys] = np.eye(nx_phys)
    ocp.cost.W_e = Q_N
    yref = np.zeros(nx_phys)
    ocp.cost.yref_e = yref
    

    return ocp


# ======================================================================
# L1 TERMINAL COST OCP (Soft Constraints via Slack Variables)
# ======================================================================

#Note : this function is implemented but i did not testes it fully or used it
# so i let it here for reference but no guarantee it works as intended

def build_ocp_l1(model: AcadosModel,
                 x0: np.ndarray,
                 N: int = 100,
                 dt: float = 0.02,
                 Q: np.ndarray = None,
                 Q_N: np.ndarray = None,
                 R: float = 0.1,
                 S_time: float = 1e-4,
                 w_eps: np.ndarray = None):

    """
    Build an L1-terminal OCP:

        Terminal constraints:
            g_e(x_N) = C_e x_N   with   C_e = [ I ; -I ]
            g_e(x_N) <= s,  s >= 0

        Terminal cost:
            Φ = 0.1 * x_Nᵀ Q_N x_N  +  Σ w_i * s_i
    """

    ocp = build_ocp_common(model, x0, N, dt, Q, R, S_time)

    nx = model.x.size()[0]
    nu = model.u.size()[0]

    # ============================================================
    # 1) TERMINAL COST (Quadratic L2 part)
    # ============================================================
    if Q_N is None:
        Q_N = np.diag([400, 400, 1/9, 1/9, 1, 1, 1/9])

    ocp.cost.cost_type_e = "EXTERNAL"
    ocp.cost.cost_ext_fun_type_e = "casadi"

    x = model.x
    terminal_cost_expr = 0.1 * cs.dot(x, Q_N @ x)
    ocp.model.cost_expr_ext_cost_e = terminal_cost_expr


    # ============================================================
    # 2) TERMINAL GENERAL LINEAR CONSTRAINTS  g_e(x) = C_e x
    #    (we enforce |x_N| <= s via [I; -I] x_N <= s)
    # ============================================================
    ng_e = 2 * nx                  # number of constraints

    C_e = np.vstack([np.eye(nx),   # x <= s
                     -np.eye(nx)]) # -x <= s  →  x >= -s

    D_e = np.zeros((ng_e, nu))     # no terminal u-dependence

    ocp.constraints.C_e = C_e
    ocp.constraints.D_e = D_e

    # Hard bounds BEFORE slack addition:
    #    -∞ <= C_e x <= 0     (slack will shift the upper bound and relax hard constraint)
    ocp.constraints.lg_e = -np.inf * np.ones(ng_e)
    ocp.constraints.ug_e = np.zeros(ng_e)


    # ============================================================
    # 3) SOFT-CONSTRAINT (terminal node)
    # ============================================================

    # Slack indexing 
    # Each general constraint gets exactly ONE slack variable
    ocp.constraints.idxs_rev_e = np.arange(ng_e)

    # Slack bounds:    0 <= s <= inf ---
    ocp.constraints.ls_e = np.zeros(ng_e)
    ocp.constraints.us_e = 1e12 * np.ones(ng_e)


    # ============================================================
    # 4) TERMINAL SLACK COST  (L1 penalty ONLY)
    # ============================================================

    # weights for |x_N|
    if w_eps is None:
        w_eps_vec = np.array([400, 400, 1/9, 1/9, 1, 1, 1/9])/20.0
    else:
        w_eps_vec = w_eps

    # duplicated because constraints are [ +x ; -x ]
    w = np.concatenate([w_eps_vec, w_eps_vec])

    # L1 cost terms (linear terms) ---
    ocp.cost.zl_e = w      # gradient wrt lower slack
    ocp.cost.zu_e = w      # gradient wrt upper slack

    #just for acados, we don't use Hessian terms for slacks
    ocp.cost.Zl_e = np.zeros(ng_e)
    ocp.cost.Zu_e = np.zeros(ng_e)

    return ocp

